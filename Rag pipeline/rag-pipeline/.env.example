# Choose ONE generation backend and set its key.
# The pipeline auto-detects which key is present.

# Anthropic (Claude) — recommended
ANTHROPIC_API_KEY=

# OpenAI — alternative
OPENAI_API_KEY=

# Which backend + model to use for generation
LLM_BACKEND=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-4-6    # or e.g. gpt-4o-mini for openai

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval confidence threshold below which the pipeline
# refuses to answer instead of hallucinating
MIN_RETRIEVAL_SCORE=0.35
