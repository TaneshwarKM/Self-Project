# Anthropic API key — required. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model to drive the agent loop
AGENT_MODEL=claude-sonnet-4-6

# Safety limits
MAX_AGENT_STEPS=8          # hard cap on think→act→observe iterations per task
TOOL_TIMEOUT_SECONDS=10    # kill any single tool call that hangs
MAX_TOOL_RETRIES=2         # retries on a failed tool call before giving up on that step

# Optional — only needed if you wire up the real web_search tool
# to a live search API instead of the offline stub
SERPAPI_KEY=
