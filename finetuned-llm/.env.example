# Hugging Face token — needed to download gated base models (e.g. Llama-3)
HF_TOKEN=

# Weights & Biases — optional, for experiment tracking
WANDB_API_KEY=
WANDB_PROJECT=support-ticket-intent-finetune

BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
OUTPUT_DIR=./adapters/ticket-intent-lora

# QLoRA hyperparameters
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LEARNING_RATE=2e-4
NUM_EPOCHS=3
BATCH_SIZE=4
